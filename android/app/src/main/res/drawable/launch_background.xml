<?xml version="1.0" encoding="utf-8"?>
<!-- Modify this file to customize your launch splash screen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Matches AppColors.pageBackground so the moment before Flutter's
         first frame (and Android 12+'s own launcher-icon splash) reads as
         PocketFinds' background, not a plain white flash. -->
    <item android:drawable="@color/launch_background" />
</layer-list>
